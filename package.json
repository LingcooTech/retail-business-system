{
  "name": "retail-business-system",
  "version": "0.1.0",
  "private": true,
  "description": "A production-ready application starter built with NestJS, Fastify, Drizzle and React.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "corepack pnpm --parallel --filter @retail-business-system/server --filter @retail-business-system/admin --filter @retail-business-system/web dev",
    "dev:server": "corepack pnpm --filter @retail-business-system/server dev",
    "dev:worker": "corepack pnpm --filter @retail-business-system/server dev:worker",
    "dev:admin": "corepack pnpm --filter @retail-business-system/admin dev",
    "dev:web": "corepack pnpm --filter @retail-business-system/web dev",
    "build": "corepack pnpm -r --if-present run build",
    "typecheck": "corepack pnpm -r --if-present run typecheck",
    "test": "corepack pnpm -r --if-present run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build",
    "db:generate": "corepack pnpm --filter @retail-business-system/server db:generate",
    "db:migrate": "corepack pnpm --filter @retail-business-system/server db:migrate",
    "db:studio": "corepack pnpm --filter @retail-business-system/server db:studio",
    "start": "corepack pnpm --filter @retail-business-system/server start:prod",
    "start:worker": "corepack pnpm --filter @retail-business-system/server start:worker"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.5.2",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0"
  }
}
